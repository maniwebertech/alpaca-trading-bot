# Copy this file to .env and fill in your Alpaca PAPER trading keys.
# Get them from https://app.alpaca.markets -> Paper account -> API Keys
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Keep this true. Set to false only if you deliberately want a live account.
ALPACA_PAPER=true
