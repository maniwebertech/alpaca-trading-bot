# Keys of the SEPARATE Alpaca paper account used by the Gold Breakout bot (gold_bot.py).
# Copy this file to .env.gold and fill in the keys. .env.gold is private: never share or commit it.
# Get them from https://app.alpaca.markets -> switch to the gold paper account -> API Keys
GOLD_ALPACA_API_KEY=your_gold_paper_api_key_here
GOLD_ALPACA_SECRET_KEY=your_gold_paper_secret_key_here

# Keep this true. Set to false only if you deliberately want a live account.
GOLD_ALPACA_PAPER=true
